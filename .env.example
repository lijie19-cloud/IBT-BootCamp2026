# Safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Future server-only values. Never prefix secrets with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/markethub
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/markethub
# AUTH_SECRET=replace-with-a-long-random-server-only-secret
# AUTH_TRUST_HOST=true
# STORAGE_BUCKET=markethub-product-images
# STORAGE_ACCESS_KEY_ID=server-only-access-key
# STORAGE_SECRET_ACCESS_KEY=server-only-secret-key
